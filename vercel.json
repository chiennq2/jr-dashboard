{
  "rewrites": [
    {
      "source": "/api/jira/:path*",
      "destination": "/api/jira?path=:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/odoo",
      "destination": "/odoo-auth.html"
    },
    {
      "source": "/odoo-login",
      "destination": "/odoo-auth.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/app"
    }
  ]
}
