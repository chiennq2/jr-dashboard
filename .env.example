# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret key for signing session cookies (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Comma-separated list of emails allowed to log in (case-insensitive)
ALLOWED_EMAILS=

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Odoo auth bridge ──────────────────────────────────────────────────────────
# Base URL of the Odoo API, e.g. https://odoo.company.com
ODOO_API_BASE=

# 16/24/32-byte UTF-8 secret used to decrypt upstream payloads and encrypt the Odoo cookie
ODOO_AUTH_SECRET=

# ── Jira ──────────────────────────────────────────────────────────────────────
# Base URL of your Jira instance, e.g. https://yourcompany.atlassian.net
JIRA_BASE=

# Jira API token (https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_TOKEN=

# Set to "true" if your Jira instance uses a self-signed certificate
JIRA_ALLOW_SELF_SIGNED=false
